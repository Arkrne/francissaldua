# ----------------------------------------------------------------------------
# Environment variables template. Copy to `.env.local` for local development:
#     cp .env.example .env.local
# For production, set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit a real `.env.local` / `.env` (they are git-ignored on purpose).
# ----------------------------------------------------------------------------

# ImageKit URL endpoint — safe to expose to the browser (NEXT_PUBLIC_ prefix).
# When unset, the site falls back to serving images straight from /public.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Server-only credentials. Used ONLY by `npm run upload:imagekit` to push the
# images in /public to ImageKit. Do not add the NEXT_PUBLIC_ prefix to these and
# do not reference them from any client component — that would leak the keys.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
